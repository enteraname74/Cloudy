# Database related variables
# Supported database, possibles values are: sqlite, postgres
DB_FLAVOR=sqlite
DB_USER=
DB_PASSWORD=
DB_NAME=

# Secret used for generating tokens
AUTH_SECRET=
# Key for using Acoustid services (ineffective for now)
ACOUSTID_API_KEY=
# Space per folder for each user, except for the admin
TOTAL_SPACE_PER_FOLDER=15

# To add a default admin user to the app
ADMIN_PASSWORD=
ADMIN_USERNAME=

# Folder watched by the server: music files put in <IMPORT_FOLDER_PATH>/<username>/ are imported for that user.
# With docker, it is enabled by default (./import next to compose.yaml): set it to an empty value to disable it.
# Without docker, set it to an absolute path to enable it.
# IMPORT_FOLDER_PATH=
# Search the metadata of imported files on remote sources (Acoustid, requires ACOUSTID_API_KEY),
# instead of only using the metadata of the files. Possible values: true, false (default).
IMPORT_FOLDER_SEARCH_METADATA=false

# Docker only: user and group of the host owning the import folder (see the `id` command).
# Defaults to 1000, the first user on most Linux distributions.
# PUID=1000
# PGID=1000

# activate or de-activate dev mode
DEV_MODE=false
# enable the swagger route accessible in /swagger
SWAGGER=false

# For server logging:
# Possibles values: TRACE, DEBUG, INFO, WARN, ERROR, OFF, ALL
ROOT_LOG_LEVEL=WARN

CLOUDY_LOG_LEVEL=INFO

KTOR_LOG_LEVEL=INFO

NETTY_LOG_LEVEL=WARN
JETTY_LOG_LEVEL=WARN

EXPOSED_LOG_LEVEL=WARN

JAUDIOTAGGER_LOG_LEVEL=WARN
