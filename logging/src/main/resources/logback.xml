<configuration>

    <property name="ROOT_LOG_LEVEL" value="${ROOT_LOG_LEVEL:-INFO}"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="${ROOT_LOG_LEVEL:-WARN}">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="org.eclipse.jetty" level="${JETTY_LOG_LEVEL:-WARN}"/>
    <logger name="io.netty" level="${NETTY_LOG_LEVEL:-WARN}"/>

    <logger name="io.ktor" level="${KTOR_LOG_LEVEL:-INFO}"/>

    <logger name="Exposed" level="${EXPOSED_LOG_LEVEL:-WARN}"/>
    <logger name="org.jetbrains.exposed" level="${EXPOSED_LOG_LEVEL:-WARN}"/>

    <logger name="org.jaudiotagger" level="${JAUDIOTAGGER_LOG_LEVEL:-WARN}"/>

    <logger name="com.github.enteraname74" level="${CLOUDY_LOG_LEVEL:-INFO}"/>

</configuration>